    </Content>
    <Content Include="..\..\..\icons\vertex-original-512.png">
      <Link>ProviderAssets\Screenshot.png</Link>
    </Content>
  </ItemGroup>
  <Import Project="$(WapProjPath)\Microsoft.DesktopBridge.targets" />
</Project>
