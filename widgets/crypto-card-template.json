{
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "type": "AdaptiveCard",
  "version": "1.5",
  "body": [
    {
      "type": "TextBlock",
      "text": "VERTEX · ${name}",
      "size": "Medium",
      "weight": "Bolder",
      "color": "Accent"
    },
    {
      "type": "TextBlock",
      "text": "${price}",
      "size": "ExtraLarge",
      "weight": "Bolder",
      "spacing": "Medium"
    },
    {
      "type": "TextBlock",
      "text": "${change}",
      "weight": "Bolder",
      "color": "${changeColor}",
      "spacing": "Small"
    },
    {
      "type": "TextBlock",
      "text": "${asof}",
      "size": "Small",
      "isSubtle": true,
      "wrap": true
    },
    {
      "type": "TextBlock",
      "text": "${source}",
      "size": "Small",
      "isSubtle": true,
      "wrap": true
    }
  ],
  "actions": [
    {
      "type": "Action.Execute",
      "title": "Apri Vertex",
      "verb": "open-vertex"
    }
  ]
}
