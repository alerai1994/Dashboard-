{
  "name": "Vertex · Global Markets",
  "short_name": "Vertex",
  "description": "Dashboard dei mercati e delle criptovalute",
  "id": "./?vertexIcon=original",
  "start_url": "./?vertexIcon=original",
  "scope": "./",
  "display": "standalone",
  "background_color": "#07111d",
  "theme_color": "#07111d",
  "icons": [
    {
      "src": "./icons/vertex-original-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icons/vertex-original-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    }
  ],
  "widgets": [
    {
      "name": "Vertex · Bitcoin (BTC)",
      "short_name": "BTC",
      "description": "Prezzo e variazione di Bitcoin (BTC) nel pannello Widget di Windows 11",
      "tag": "vertex-crypto-btc",
      "template": "vertex-crypto-price",
      "ms_ac_template": "./widgets/crypto-card-template.json",
      "data": "./widgets/crypto-card-default.json",
      "type": "application/json",
      "screenshots": [
        {
          "src": "./icons/vertex-original-512.png",
          "sizes": "512x512",
          "type": "image/png",
          "label": "Anteprima widget Vertex"
        }
      ],
      "icons": [
        {
          "src": "./icons/vertex-original-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ],
      "auth": false,
      "update": 900,
      "multiple": true
    },
